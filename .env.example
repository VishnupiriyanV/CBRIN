# Frontend (Vite) — base URL of the backend API. Leave unset for local dev (defaults to
# http://localhost:8000). Only needed if the backend runs on a different host/port.
VITE_API_URL=http://localhost:8000

# Backend — comma-separated list of allowed CORS origins for the frontend dev server.
# Defaults to the standard Vite ports (3000, 5173) on localhost/127.0.0.1 if unset.
VAULT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Backend — enables the hosted Whisper API for transcription instead of local (offline)
# Whisper. Optional; if unset, local 'openai-whisper' is used (must be installed — see
# backend/requirements.txt).
OPENAI_API_KEY=

# Backend — default local Whisper model tier when OPENAI_API_KEY is unset. One of: base,
# small, medium (also selectable per-upload in the UI — see LibraryModal). Bigger = more
# accurate, slower. Defaults to 'small'; 'base' mangles proper nouns and technical vocabulary,
# which are exactly the high-value search terms (IMPROVEMENT-PLAN.md 3.4).
VAULT_WHISPER_MODEL=small

# ENGINE (Layer 3) — narrative analysis LLM. OpenAI-wire-compatible; Gemini 2.0 Flash by default.
# Leave VAULT_LLM_API_KEY unset to run ENGINE in heuristic (degraded) mode with no LLM cost.
VAULT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VAULT_LLM_API_KEY=
VAULT_LLM_MODEL=gemini-2.0-flash
